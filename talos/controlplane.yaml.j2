---
machine:
  type: controlplane
  # ca merges as a unit; crt must be repeated alongside key
  ca:
    crt: {{ certs.os.crt }}
    key: {{ certs.os.key }}
---
# The secrets bundle holds certificates and keys base64-encoded; !!binary decodes them to the PEM these documents expect
apiVersion: v1alpha1
kind: EtcdCAConfig
issuingCA:
  cert: !!binary {{ certs.etcd.crt }}
  key: !!binary {{ certs.etcd.key }}
---
apiVersion: v1alpha1
kind: EtcdMemberConfig
advertisedSubnets:
  - 192.168.42.0/24
extraArgs:
  listen-metrics-urls: http://0.0.0.0:2381
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
---
apiVersion: v1alpha1
kind: KubeAPIServerCAConfig
issuingCA:
  cert: !!binary {{ certs.k8s.crt }}
  key: !!binary {{ certs.k8s.key }}
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
certExtraSANs:
  - k8s.internal
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: CrossNamespaceVolumeDataSource=true
image: registry.k8s.io/kube-apiserver:v1.37.3
---
apiVersion: v1alpha1
kind: KubeAggregatorCAConfig
issuingCA:
  cert: !!binary {{ certs.k8saggregator.crt }}
  key: !!binary {{ certs.k8saggregator.key }}
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
    enabled: true
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: CrossNamespaceVolumeDataSource=true
image: registry.k8s.io/kube-controller-manager:v1.37.3
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - secretbox:
            keys:
              - name: key2
                secret: {{ secrets.secretboxencryptionsecret }}
        - identity: {}
      resources:
        - secrets
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.3
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
extraArgs:
  bind-address: 0.0.0.0
image: registry.k8s.io/kube-scheduler:v1.37.3
---
apiVersion: v1alpha1
kind: KubeServiceAccountConfig
issuer:
  privateKey: !!binary {{ certs.k8sserviceaccount.key }}
  issuerURL: https://k8s.internal:6443
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - actions-runner-system
  - system-upgrade
