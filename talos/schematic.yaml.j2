---
customization:
  extraKernelArgs:
    - -selinux # Removes the default selinux=1
    - audit=0
    - i915.enable_guc=3
    - intel_iommu=on
    - iommu=pt
    - module_blacklist=igc
    - selinux=0
    - sysctl.kernel.kexec_load_disabled=1
    - talos.auditd.disabled=1
    - thunderbolt.host_reset=0
  systemExtensions:
    officialExtensions:
      - siderolabs/drbd
      - siderolabs/gvisor
      - siderolabs/i915
      - siderolabs/intel-ucode
      - siderolabs/mei
      - siderolabs/nfsrahead
      - siderolabs/thunderbolt
