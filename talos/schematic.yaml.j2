---
customization:
  extraKernelArgs:
    - -selinux # Disable SELinux (removes the default selinux=1)
    - audit=0 # Disable kernel audit
    - i915.enable_guc=3 # Meteor Lake CPU & Intel iGPU
    - intel_iommu=on # PCI Passthrough
    - iommu=pt # PCI Passthrough
    - module_blacklist=igc # Thunderbolt NICs (disable igc)
    - selinux=0 # Disable SELinux
    - sysctl.kernel.kexec_load_disabled=1 # Meteor Lake CPU & Intel iGPU
    - talos.auditd.disabled=1 # Disable Talos auditd (pair with audit=0)
    - thunderbolt.host_reset=0 # Thunderbolt NICs
  systemExtensions:
    officialExtensions:
      - siderolabs/drbd # Miroir DRBD9 Replication
      - siderolabs/gvisor # Sandboxed Containers
      - siderolabs/i915 # Intel iGPU
      - siderolabs/intel-ucode # Intel CPU Microcode
      - siderolabs/mei # Intel iGPU
      - siderolabs/nfsrahead # NFS Readahead
      - siderolabs/thunderbolt # Thunderbolt NICs
